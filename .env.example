# Muhit o'zgaruvchilari (hammasi ixtiyoriy). Nusxa: cp .env.example .env.local
# Vercel'da: Project → Settings → Environment Variables

# Brend — sayt nomi va logosi (mijozga qarab; berilmasa — standart). Logo fayllari: public/brand/ papkasiga.
# Qisqa nom matnlarda va fayl nomlarida ishlatiladi ("Bilim'ga kirish", "bilim-zaxira-2026-11-09.json")
VITE_BRAND_NAME=
VITE_BRAND_SHORT_NAME=
VITE_BRAND_DESCRIPTION=
# Masalan: /brand/logo.svg (kvadrat, shaffof fon yaxshi); favicon berilmasa — logo ishlatiladi
VITE_BRAND_LOGO=
VITE_BRAND_FAVICON=
# iPhone "Bosh ekranga qo'shish": PNG 180×180; havola rasmi (Telegram, Facebook): 1200×630, yo'l yoki https URL
VITE_BRAND_APPLE_ICON=
VITE_BRAND_OG_IMAGE=

# Bulutli rejim (Supabase). Ikkalasi berilmasa — ilova lokal (brauzer) va demo rejimda ishlaydi
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Saytning to'liq manzili: og:url, canonical, og:image uchun (Vercel'da avtomatik aniqlanadi)
VITE_SITE_URL=

# Yordam bo'limi va landing'dagi bog'lanish
VITE_SUPPORT_TELEGRAM=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# Sotuvchi paneli (/owner) paroli xeshi — lokal/demo rejim uchun: npm run owner:password "uzun-parol"
# (Supabase rejimida sotuvchi email/parol bilan kiradi, platform_admins jadvalida bo'lishi kerak)
VITE_OWNER_PASSWORD_HASH=

# Namoyish sayti (masalan, GitHub Pages): 1 — faqat demo, ro'yxatdan o'tish yo'q; asosiy sayt havolasi
VITE_DEMO_ONLY=
VITE_MAIN_SITE_URL=
