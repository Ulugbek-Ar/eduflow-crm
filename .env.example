# EduFlow CRM — muhit o'zgaruvchilari (hammasi ixtiyoriy). Nusxa: cp .env.example .env.local
# Vercel'da: Project → Settings → Environment Variables

# Bulutli rejim (Supabase). Ikkalasi berilmasa — ilova lokal (brauzer) va demo rejimda ishlaydi
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Saytning to'liq manzili: og:url, canonical, og:image uchun (Vercel'da avtomatik aniqlanadi)
VITE_SITE_URL=

# Yordam bo'limi va landing'dagi bog'lanish
VITE_SUPPORT_TELEGRAM=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=

# Sotuvchi paneli (/owner) paroli xeshi — lokal/demo rejim uchun: npm run owner:password "uzun-parol"
# (Supabase rejimida sotuvchi email/parol bilan kiradi, platform_admins jadvalida bo'lishi kerak)
VITE_OWNER_PASSWORD_HASH=

# Namoyish sayti (masalan, GitHub Pages): 1 — faqat demo, ro'yxatdan o'tish yo'q; asosiy sayt havolasi
VITE_DEMO_ONLY=
VITE_MAIN_SITE_URL=
